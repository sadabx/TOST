<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Trionine.TOST.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#26352B" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1B1F1C" />
      <Setter Property="BorderBrush" Value="#303832" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="#232426" />
      <Setter Property="BorderBrush" Value="#414346" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#36383B" />
    </Style>
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="avares://TOST.Desktop/Assets/TOST.png"
                ToolTipText="TOST"
                Clicked="ShowFloatingIcon">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Show Floating Icon" Click="ShowFloatingIcon" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Install / Repair SLSsteam" Click="InstallSlsSteam" />
            <NativeMenuItem Header="Check for Updates" Click="CheckForUpdates" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit" Click="ExitApplication" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
