<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\Assets\tost.ico</ApplicationIcon>
    <AssemblyName>TOST.WinForms.Legacy</AssemblyName>
    <RootNamespace>Trionine.TOST</RootNamespace>
    <Version>1.2.0</Version>
    <Title>TOST WinForms Legacy Reference</Title>
    <Product>TOST</Product>
    <Company>Trionine</Company>
    <Authors>Sadabx</Authors>
    <Description>Retained legacy WinForms reference frontend for TOST.</Description>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\Assets\tost.ico" Link="Assets\tost.ico" />
    <EmbeddedResource Include="..\..\Assets\TOST.png" LogicalName="TOST.Assets.TOST.png" />
    <Content Include="..\..\Assets\TOST.png" Link="Assets\TOST.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
</Project>
